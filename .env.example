DATABASE_URL=postgres://emfs:emfs_dev_password@localhost:5432/emfs_book_shelf
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary (server-only — never NEXT_PUBLIC_). Manual cover uploads are stored here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=emfs-covers

# Optional — raises Google Books API quota for English program-book autofill.
GOOGLE_BOOKS_API_KEY=

# Optional — outbound email provider (Resend). If unset, emails are logged to server console in dev.
RESEND_API_KEY=
EMAIL_FROM=EMFSC Book Shelf <no-reply@emfs.app>

