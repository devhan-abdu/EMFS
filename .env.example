DATABASE_URL=postgres://emfs:emfs_dev_password@localhost:5432/emfs_book_shelf
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary (server-only — never NEXT_PUBLIC_). Manual cover uploads are stored here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=emfs-covers

# Optional — raises Google Books API quota for English program-book autofill.
GOOGLE_BOOKS_API_KEY=

# Telegram bot (server-only). Create the bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Username of the bot without the @ (used in links and admin instructions).
TELEGRAM_BOT_USERNAME=
# Random string Telegram echoes in X-Telegram-Bot-Api-Secret-Token. Required in production.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
