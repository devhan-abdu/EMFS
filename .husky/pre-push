#!/bin/sh
set -eu

echo "🚀 Pre-push check..."

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  set +u; . "$NVM_DIR/nvm.sh"; if [ -f .nvmrc ]; then nvm use >/dev/null; fi; set -u
fi

# Keep typecheck so bad code doesn't break main
echo "Typechecking full repository..."
pnpm typecheck